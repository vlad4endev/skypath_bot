# ==============================
# SkyPath VPN Bot — .env файл
# ==============================

# === TELEGRAM ===
BOT_TOKEN=1234567890:AABBCCDDEEFFGGHHIIJJKKLLMMNNOOPPqqrr
BOT_USERNAME=SkyPathVPN_Bot
BRAND_NAME="SKYFLOW VPN"
ADMIN_IDS=86517651
ADMIN_NOTIFY_ID=86517651

# === WEB ADMIN PANEL ===
# Сгенерировать: python3 scripts/gen_admin_password.py "ваш-пароль"
# Или в Docker: docker compose exec bot python scripts/gen_admin_password.py "ваш-пароль"
ADMIN_PASSWORD=
ADMIN_PASSWORD_SALT=
SUPPORT_URL=https://t.me/SkyPathsupport
SUPPORT_CHANNEL=@SkyPathVPN

# === SERVER ===
# webhook — Telegram шлёт POST на /webhook; polling — если VPS недоступен для Telegram DC
BOT_MODE=webhook
WEBHOOK_BASE_URL=https://your-domain.com
# Секрет для Telegram webhook (только A-Za-z0-9_-). Пусто = sha256(BOT_TOKEN)
WEBHOOK_SECRET=
MINI_APP_URL=https://your-domain.com/app
NGINX_DOMAIN=your-domain.com
PORT=8080
# Порт бота на хосте (8082 часто занят другими контейнерами)
BOT_HOST_PORT=8084
CERTBOT_EMAIL=admin@your-domain.com

# === POSTGRESQL (только внутри Docker-сети, порт 5432) ===
DB_URL=postgresql+asyncpg://vpnbot:changeme123@postgres:5432/skypath
DB_PASSWORD=changeme123

# === REDIS (Docker: redis, локально: localhost) ===
REDIS_URL=redis://redis:6379/0

# === PLATEGA (оплата картой) ===
PLATEGA_MERCHANT_ID=your_merchant_id
PLATEGA_SECRET=your_api_secret

# === 3X-UI VPN ПАНЕЛЬ ===
XUI_HOST=https://178.208.87.245:2053
XUI_URL_PREFIX=/KolbUBTWA0
XUI_USERNAME=admin
XUI_PASSWORD=your_password
# API Token из Settings → Security → API Token (рекомендуется для бота)
XUI_API_TOKEN=
# Путь subscription-сервера в 3X-UI (Settings → Subscription), по умолчанию /sub/
XUI_SUB_PATH=/sub/
# Полная база subscription URL без subId (рекомендуется: порт subscription-сервера).
# Пример: https://178.208.87.245:2096/vk098
# Если пусто — используется XUI_HOST + XUI_SUB_PATH (без XUI_URL_PREFIX).
XUI_SUB_BASE_URL=

# === INBOUND IDs (из 3X-UI панели) ===
INBOUND_RU=1
INBOUND_US=19
INBOUND_KZ=20
INBOUND_DE=21
INBOUND_NL=22
